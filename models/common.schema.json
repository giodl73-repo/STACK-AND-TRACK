{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/giodl73-repo/STACK-AND-TRACK/models/common.schema.json",
  "title": "Stack & Track Common Types",
  "$defs": {
    "sourceType": {
      "enum": [
        "measured",
        "human-provided",
        "calculated",
        "proposed",
        "unknown"
      ]
    },
    "sourcedNumber": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "sourceType"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "sourceType": {
          "$ref": "#/$defs/sourceType"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceType": {
                "const": "unknown"
              }
            },
            "required": [
              "sourceType"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "source": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "number"
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source"
            ]
          }
        }
      ]
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "reference"
      ],
      "properties": {
        "type": {
          "enum": [
            "measurement",
            "query",
            "dashboard",
            "test",
            "document",
            "decision",
            "other"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "state": {
          "enum": [
            "acceptable",
            "watch",
            "breached",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    },
    "humanAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "acceptedBy",
        "acceptedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "rejected"
          ]
        },
        "acceptedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "acceptedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "acceptedBy": {
                "type": "string",
                "minLength": 1
              },
              "acceptedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    }
  }
}
