{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/giodl73-repo/STACK-AND-TRACK/models/role-review.schema.json",
  "title": "Stack & Track Role Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "reviewedAt",
    "artifacts",
    "reviews",
    "fixedPoint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "reviewId": {
      "type": "string"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/roleDisposition"
      }
    },
    "dissent": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fixedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "openCritical",
        "openMajor",
        "defers"
      ],
      "properties": {
        "status": {
          "enum": [
            "reached",
            "not-reached"
          ]
        },
        "openCritical": {
          "type": "integer",
          "minimum": 0
        },
        "openMajor": {
          "type": "integer",
          "minimum": 0
        },
        "defers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/defer"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "reached"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "openCritical": {
                "const": 0
              },
              "openMajor": {
                "const": 0
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "roleDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "cluster",
        "disposition",
        "note",
        "findings"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "cluster": {
          "enum": [
            "parliament",
            "stakeholder",
            "assurance",
            "editorial",
            "panel"
          ]
        },
        "disposition": {
          "enum": [
            "pass",
            "finding",
            "defer"
          ]
        },
        "note": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "finding"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "findings": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "findings": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "artifact",
        "finding",
        "owner",
        "status",
        "closureCondition"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "major",
            "minor"
          ]
        },
        "artifact": {
          "type": "string"
        },
        "finding": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "closureCondition": {
          "type": "string"
        },
        "closureEvidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "defer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "destination",
        "owner"
      ],
      "properties": {
        "topic": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      }
    }
  }
}
